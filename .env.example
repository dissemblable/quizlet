# Variables de docker-compose.prod.yml, sur le serveur.
# Copier en .env à côté du fichier compose (chmod 600). Ne jamais versionner .env.
# (En développement local, rien à copier : voir apps/api/.env.development.)

# Mot de passe PostgreSQL : générer avec `openssl rand -hex 32`
# (hexadécimal, donc utilisable tel quel dans l'URL de connexion).
POSTGRES_PASSWORD=

# Origine publique de l'application, sans « / » final (contrôle CSRF).
APP_ORIGIN=https://quizlet.valldoy.com

# URL de déconnexion d'Authelia (bouton « Se déconnecter »).
AUTH_LOGOUT_URL=https://auth.valldoy.com/logout

# Proxy autorisé à transmettre les en-têtes Remote-* : le conteneur nginx du stack SSO,
# résolu par le DNS Docker du réseau `web` (son IP change à chaque recréation du conteneur).
TRUSTED_PROXIES=nginx
