# Valeurs de développement local, versionnées volontairement : aucune n'est un secret.
# Pour surcharger une valeur en local : apps/api/.env (ignoré par git), lu en priorité.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://quizlet:quizlet@127.0.0.1:5433/quizlet
APP_ORIGIN=http://localhost:5180

# Authentification factice (Authelia absent en local). Interdite si NODE_ENV=production.
# Pour tester le mode « en-têtes du proxy » : vider DEV_AUTH_USER dans apps/api/.env et envoyer
# Remote-User depuis 127.0.0.1 (TRUSTED_PROXIES vaut 127.0.0.1,::1 par défaut hors production).
DEV_AUTH_USER=demo
DEV_AUTH_NAME=Utilisateur Démo
DEV_AUTH_EMAIL=demo@example.com
