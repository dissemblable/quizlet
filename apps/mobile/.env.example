# Configuration de l'app mobile. Les variables EXPO_PUBLIC_* sont lues par Metro et incluses dans
# le bundle : aucun secret ici (le client OIDC est public).
# Copier ce fichier vers `.env` (ignoré par git) et y mettre les vraies URLs.

# Origine de l'API (https, sans « / » final).
EXPO_PUBLIC_API_URL=https://quizlet.example.com
# Origine du portail Authelia (https, sans « / » final).
EXPO_PUBLIC_AUTH_URL=https://auth.example.com
# Identifiant du client OIDC public enregistré chez Authelia.
EXPO_PUBLIC_OIDC_CLIENT_ID=quizlet-mobile
