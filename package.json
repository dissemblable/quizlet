{
  "name": "quizlet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint lint:root",
    "lint:root": "biome check biome.json turbo.json package.json tsconfig.base.json",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @quizlet/api db:generate",
    "db:migrate": "pnpm --filter @quizlet/api db:migrate",
    "db:seed": "pnpm --filter @quizlet/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
